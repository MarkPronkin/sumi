<resources>
    <style name="Theme.Cinema.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#FF7A26</item>
    </style>
    <style name="Theme.Cinema" parent="Theme.Cinema.Base" />
    <style name="Theme.Cinema.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sumi_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Cinema</item>
    </style>
</resources>
